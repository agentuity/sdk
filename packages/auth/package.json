			],
			"types": [
				"./dist/agentuity/types.d.ts"
			],
			"schema": [
				"./dist/schema.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsc --build",
		"clean": "rm -rf dist .tsbuildinfo",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"better-auth": "1.4.11",
		"drizzle-orm": "^0.45.0"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"@agentuity/react": "workspace:*",
		"@opentelemetry/api": "^1.9.0",
		"hono": "^4.0.0"
	},
	"devDependencies": {
		"@agentuity/react": "workspace:*",
		"@agentuity/test-utils": "workspace:*",
		"@opentelemetry/api": "^1.9.0",
		"@types/react": "^18.3.18",
		"drizzle-kit": "^0.31.8",
