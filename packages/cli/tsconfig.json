{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"tsBuildInfoFile": "./tsconfig.tsbuildinfo",
		"types": ["node"],
		"resolveJsonModule": true,
		"paths": {
			"@agentuity/core": ["../core/src"],
			"@agentuity/server": ["../server/src"],
			"@agentuity/storage": ["../storage/src"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["test/**/*", "src/**/*.test.ts", "src/cmd/project/templates/**/*"],
	"references": [{ "path": "../core" }, { "path": "../server" }, { "path": "../storage" }]
}
