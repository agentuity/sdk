{
	"name": "@agentuity/core",
	"version": "1.0.34",
	"license": "Apache-2.0",
	"author": "Agentuity employees and contributors",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"AGENTS.md",
		"README.md",
		"src",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./workbench": {
			"types": "./dist/workbench.d.ts",
			"default": "./dist/workbench.js"
		},
		"./error": {
			"types": "./dist/error.d.ts",
			"default": "./dist/error.js"
		},
		"./pagination": {
			"types": "./dist/services/pagination.d.ts",
			"default": "./dist/services/pagination.js"
		},
		"./adapter": {
			"types": "./dist/services/adapter.d.ts",
			"default": "./dist/services/adapter.js"
		},
		"./exception": {
			"types": "./dist/services/exception.d.ts",
			"default": "./dist/services/exception.js"
		},
		"./config": {
			"types": "./dist/services/config.d.ts",
			"default": "./dist/services/config.js"
		},
		"./api": {
			"types": "./dist/services/api.d.ts",
			"default": "./dist/services/api.js"
		},
		"./*": {
			"types": "./dist/services/*/index.d.ts",
			"default": "./dist/services/*/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"workbench": [
				"./dist/workbench.d.ts"
			],
			"error": [
				"./dist/error.d.ts"
			],
			"pagination": [
				"./dist/services/pagination.d.ts"
			],
			"adapter": [
				"./dist/services/adapter.d.ts"
			],
			"exception": [
				"./dist/services/exception.d.ts"
			],
			"config": [
				"./dist/services/config.d.ts"
			],
			"api": [
				"./dist/services/api.d.ts"
			],
			"*": [
				"./dist/services/*/index.d.ts"
			]
		}
	},
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "bunx tsc --build --force",
		"typecheck": "bunx tsc --noEmit",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@agentuity/test-utils": "workspace:*",
		"@types/bun": "latest",
		"bun-types": "latest",
		"esbuild": "^0.25.0",
		"typescript": "^5.9.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false
}
