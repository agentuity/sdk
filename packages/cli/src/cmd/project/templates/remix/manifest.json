{
	"framework": "remix",
	"displayName": "React Router",
	"composableFiles": {
		"translate": {
			"path": "app/lib/translate.ts",
			"markers": {
				"imports":        { "syntax": "//" },
				"module":         { "syntax": "//" },
				"translate-pre":  { "syntax": "//" },
				"translate-post": { "syntax": "//" }
			}
		},
		"page": {
			"path": "app/routes/home.tsx",
			"markers": {
				"imports":             { "syntax": "//" },
				"state":               { "syntax": "//" },
				"on-mount":            { "syntax": "//" },
				"on-result":           { "syntax": "//" },
				"inside-form-buttons": { "syntax": "{/* */}" },
				"after-result":        { "syntax": "{/* */}" },
				"after-form":          { "syntax": "{/* */}" }
			}
		}
	}
}
