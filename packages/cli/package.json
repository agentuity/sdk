{
	"name": "@agentuity/cli",
	"version": "3.1.11",
	"license": "Apache-2.0",
	"author": "Agentuity employees and contributors",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"agentuity": "./bin/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"AGENTS.md",
		"README.md",
		"bin",
		"dist"
	],
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "bunx tsc --build --force && bun run build:assets",
		"build:assets": "bun ./scripts/copy-assets.ts",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun ../../tests/create/basic-flow.ts && bun ../../tests/create/non-empty-dir.ts && bun scripts/test-exit-codes.ts && bun scripts/test-response-schema.ts && bun scripts/test-batch-reporting.ts && bun scripts/test-response-envelope.ts && bun scripts/test-concurrent-sessions.ts",
		"test:create": "bun ../../tests/create/basic-flow.ts",
		"test:create:non-empty": "bun ../../tests/create/non-empty-dir.ts",
		"test:exit-codes": "bun scripts/test-exit-codes.ts",
		"test:response-schema": "bun scripts/test-response-schema.ts",
		"test:batch": "bun scripts/test-batch-reporting.ts",
		"test:envelope": "bun scripts/test-response-envelope.ts",
		"test:bundled-create": "bun scripts/test-bundled-create.ts",
		"test:concurrent-sessions": "bun scripts/test-concurrent-sessions.ts",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@agentuity/aigateway": "workspace:*",
		"@agentuity/coder": "workspace:*",
		"@agentuity/coder-tui": "workspace:*",
		"@agentuity/config": "workspace:*",
		"@agentuity/core": "workspace:*",
		"@agentuity/db": "workspace:*",
		"@agentuity/email": "workspace:*",
		"@agentuity/keyvalue": "workspace:*",
		"@agentuity/schedule": "workspace:*",
		"@agentuity/server": "workspace:*",
		"@agentuity/storage": "workspace:*",
		"@agentuity/stream": "workspace:*",
		"@agentuity/task": "workspace:*",
		"@agentuity/vector": "workspace:*",
		"@types/yazl": "^3.3.1",
		"cli-table3": "^0.6.5",
		"commander": "^14.0.2",
		"dotenv": "^16.4.7",
		"enquirer": "^2.4.1",
		"ignore": "^7.0.5",
		"json-colorizer": "^3.0.1",
		"semver": "^7.7.0",
		"string-width": "^7.2.0",
		"tar": "^7.5.2",
		"tinyglobby": "^0.2.10",
		"typescript": "^5.9.0",
		"yaml": "^2.6.0",
		"yazl": "^3.3.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@agentuity/test-utils": "workspace:*",
		"@types/bun": "latest",
		"@types/node": "^22.0.0",
		"@types/semver": "^7.5.8",
		"bun-types": "latest",
		"hono": "^4.7.13"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agentuity/sdk.git",
		"directory": "packages/cli"
	}
}
