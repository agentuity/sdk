{
	"name": "@agentuity/core",
	"version": "3.1.10",
	"license": "Apache-2.0",
	"author": "Agentuity employees and contributors",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"AGENTS.md",
		"README.md",
		"src",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./error": {
			"types": "./dist/error.d.ts",
			"default": "./dist/error.js"
		},
		"./pagination": {
			"types": "./dist/services/pagination.d.ts",
			"default": "./dist/services/pagination.js"
		},
		"./adapter": {
			"types": "./dist/services/adapter.d.ts",
			"default": "./dist/services/adapter.js"
		},
		"./exception": {
			"types": "./dist/services/exception.d.ts",
			"default": "./dist/services/exception.js"
		},
		"./config": {
			"types": "./dist/services/config.d.ts",
			"default": "./dist/services/config.js"
		},
		"./api": {
			"types": "./dist/services/api.d.ts",
			"default": "./dist/services/api.js"
		}
	},
	"typesVersions": {
		"*": {
			"error": [
				"./dist/error.d.ts"
			],
			"pagination": [
				"./dist/services/pagination.d.ts"
			],
			"adapter": [
				"./dist/services/adapter.d.ts"
			],
			"exception": [
				"./dist/services/exception.d.ts"
			],
			"config": [
				"./dist/services/config.d.ts"
			],
			"api": [
				"./dist/services/api.d.ts"
			]
		}
	},
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "bunx tsc --build --force",
		"typecheck": "bunx tsc --noEmit",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@agentuity/adapter": "workspace:*",
		"@agentuity/api": "workspace:*",
		"@agentuity/config": "workspace:*",
		"@agentuity/keyvalue": "workspace:*",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@agentuity/aigateway": "workspace:*",
		"@agentuity/coder": "workspace:*",
		"@agentuity/queue": "workspace:*",
		"@agentuity/stream": "workspace:*",
		"@agentuity/test-utils": "workspace:*",
		"@agentuity/vector": "workspace:*",
		"@types/bun": "latest",
		"bun-types": "latest",
		"typescript": "^5.9.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agentuity/sdk.git",
		"directory": "packages/core"
	}
}
