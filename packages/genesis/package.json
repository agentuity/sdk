{
	"name": "@agentuity/genesis",
	"version": "3.1.17",
	"license": "Apache-2.0",
	"author": "Agentuity employees and contributors",
	"description": "Genesis SSO upstream identity verification for managed app middleware",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js",
			"default": "./dist/auth/index.js"
		},
		"./hono": {
			"types": "./dist/adapters/hono.d.ts",
			"import": "./dist/adapters/hono.js",
			"default": "./dist/adapters/hono.js"
		},
		"./tanstack-start": {
			"types": "./dist/adapters/tanstack-start.d.ts",
			"import": "./dist/adapters/tanstack-start.js",
			"default": "./dist/adapters/tanstack-start.js"
		},
		"./vercel": {
			"types": "./dist/adapters/vercel.d.ts",
			"import": "./dist/adapters/vercel.js",
			"default": "./dist/adapters/vercel.js"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "bunx tsc --build",
		"typecheck": "bunx tsc --noEmit",
		"prepublishOnly": "bun run clean && bun run build",
		"test": "bun test"
	},
	"dependencies": {
		"@agentuity/core": "workspace:*",
		"jose": "^6.0.11"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"bun-types": "latest",
		"hono": "^4.7.13",
		"typescript": "^5.9.0"
	},
	"peerDependencies": {
		"@tanstack/react-start": "^1.0.0",
		"hono": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-start": {
			"optional": true
		},
		"hono": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agentuity/sdk.git",
		"directory": "packages/genesis"
	}
}
