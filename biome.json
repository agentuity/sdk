{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,md,yml,yaml}",
			"!**/dist",
			"!**/node_modules",
			"!**/templates",
			"!**/.agentuity",
			"!**/.test-projects",
			"!**/test-interop/go-common",
			"!**/ai-elements",
			"!**/tsc-output-parser.ts",
			"!**/generated/*.ts",
			"!bun.lock",
			"!**/*.sh"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "es5",
			"quoteStyle": "single",
			"semicolons": "always",
			"bracketSpacing": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"noUnusedFunctionParameters": "warn",
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "warn",
				"useParseIntRadix": "warn",
				"noUnusedPrivateClassMembers": "warn",
				"useImportExtensions": "error"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noUnusedTemplateLiteral": "off",
				"useTemplate": "off",
				"useImportType": "off",
				"useNodejsImportProtocol": "off",
				"useExponentiationOperator": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noEmptyInterface": "off",
				"noConfusingVoidType": "off",
				"noControlCharactersInRegex": "off",
				"noDoubleEquals": "warn",
				"noGlobalIsNan": "warn",
				"noGlobalIsFinite": "warn",
				"noGlobalAssign": "warn",
				"noArrayIndexKey": "warn",
				"noAssignInExpressions": "warn",
				"noTemplateCurlyInString": "warn",
				"noImplicitAnyLet": "warn",
				"noDocumentCookie": "warn",
				"useIterableCallbackReturn": "off"
			},
			"complexity": {
				"useLiteralKeys": "off",
				"useOptionalChain": "off",
				"noBannedTypes": "off",
				"noUselessSwitchCase": "off",
				"noUselessUndefinedInitialization": "off",
				"noUselessContinue": "off",
				"noUselessTernary": "warn",
				"noUselessFragments": "warn",
				"useIndexOf": "warn"
			},
			"performance": {
				"noAccumulatingSpread": "warn"
			},
			"a11y": {
				"useButtonType": "off",
				"useSemanticElements": "off",
				"noSvgWithoutTitle": "warn",
				"noLabelWithoutControl": "warn",
				"useFocusableInteractive": "warn",
				"useMediaCaption": "warn",
				"useKeyWithClickEvents": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
