{
	"name": "@agentuity/opencode",
	"version": "1.0.25",
	"license": "Apache-2.0",
	"author": "Agentuity employees and contributors",
	"description": "Agentuity Open Code plugin with specialized AI coding agents",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"AGENTS.md",
		"README.md",
		"src",
		"dist"
	],
	"exports": {
		".": "./dist/index.js",
		"./agents": "./dist/agents/index.js",
		"./services": "./dist/services/index.js"
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts"
			],
			"agents": [
				"./dist/agents/index.d.ts"
			],
			"services": [
				"./dist/services/index.d.ts"
			]
		}
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "bunx tsc --build --force",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@agentuity/core": "workspace:*",
		"@opencode-ai/plugin": "^1.1.36",
		"yaml": "^2.8.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@agentuity/test-utils": "workspace:*",
		"@types/bun": "latest",
		"bun-types": "latest",
		"typescript": "^5.9.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false
}
