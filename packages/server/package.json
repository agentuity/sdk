{
	"name": "@agentuity/server",
	"version": "3.0.0-alpha.5",
	"license": "Apache-2.0",
	"author": "Agentuity employees and contributors",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"AGENTS.md",
		"README.md",
		"src",
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "tsgo --build --force",
		"typecheck": "tsgo --noEmit",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@agentuity/adapter": "3.0.0-alpha.5",
		"@agentuity/core": "3.0.0-alpha.5",
		"@agentuity/schema": "3.0.0-alpha.5",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@agentuity/test-utils": "3.0.0-alpha.5",
		"@types/bun": "latest",
		"@types/node": "^22.0.0",
		"bun-types": "latest",
		"typescript": "^6.0.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/agentuity/sdk.git",
		"directory": "packages/server"
	}
}
