{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,md,yml,yaml}",
			"!**/dist",
			"!**/node_modules",
			"!**/templates",
			"!**/.agentuity",
			"!**/.test-projects",
			"!**/test-interop/go-common",
			"!**/ai-elements",
			"!**/tsc-output-parser.ts",
			"!**/generated/*.ts",
			"!bun.lock",
			"!**/*.sh"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "es5",
			"quoteStyle": "single",
			"semicolons": "always",
			"bracketSpacing": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "warn",
				"useParseIntRadix": "error",
				"noUnusedPrivateClassMembers": "error"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noUnusedTemplateLiteral": "error",
				"useShorthandFunctionType": "error",
				"useExportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noGlobalIsNan": "error",
				"noGlobalIsFinite": "error",
				"noGlobalAssign": "warn",
				"noArrayIndexKey": "warn",
				"noAssignInExpressions": "warn",
				"noImplicitAnyLet": "warn",
				"useIterableCallbackReturn": "off"
			},
			"complexity": {
				"noBannedTypes": "off",
				"noUselessTernary": "error",
				"noUselessFragments": "warn",
				"useIndexOf": "error",
				"noUselessEscapeInRegex": "error",
				"useArrowFunction": "error"
			},
			"a11y": {
				"useButtonType": "off",
				"useSemanticElements": "off",
				"noSvgWithoutTitle": "warn",
				"noLabelWithoutControl": "warn",
				"useFocusableInteractive": "warn",
				"useMediaCaption": "warn",
				"useKeyWithClickEvents": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/server/src/**", "packages/core/src/**"],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": "error"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": false
	}
}
